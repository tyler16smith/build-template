# Every environment variable Build Template uses, in one place. Copy to `.env` (git-ignored) for
# the tooling (`pnpm dev`, `pnpm db:*`, `pnpm logs`, `pnpm e2e`); variables already set in the
# shell or in CI win over it.
#
# The Worker doesn't read this file. Its secrets (the "Worker" section) go in
# `apps/server/.dev.vars` locally (`pnpm dev` creates it from `.dev.vars.example`) and in
# `wrangler secret put <NAME> --env staging|production` when deployed. The README, "Setup", says
# where each value comes from.

# ---- Databases (Neon, aws-us-west-2) ---------------------------------------------------------
# Three Neon projects: build-template-local, build-template-staging and build-template-prod. Each
# has the database `app` and two roles: app_migrator owns the schema (migrations, the seed) and
# app_runtime has DML only (all the Worker ever uses).

# Local development on Neon (build-template-local). Set both or neither: unset, `pnpm dev` uses
# Postgres in Docker on port 5434.
# LOCAL_DATABASE_MIGRATOR_URL: app_migrator, direct (unpooled) URL.
LOCAL_DATABASE_MIGRATOR_URL=
# LOCAL_DATABASE_URL: app_runtime, direct URL (wrangler dev's Hyperdrive connects with it).
LOCAL_DATABASE_URL=

# Staging and production migrations: app_migrator's direct URL for that project. CI reads it from
# the GitHub environment. Don't keep it here; pass it for the one command:
#   DATABASE_MIGRATOR_URL='<url>' pnpm db:migrate --env staging
# DATABASE_MIGRATOR_URL=

# `pnpm test:db`: the isolation and role tests on real Postgres logins (`pnpm db:local` creates
# app_test in Docker).
# TEST_DATABASE_URL=postgres://app_migrator:template-local@127.0.0.1:5434/app_test
# TEST_RUNTIME_URL=postgres://app_runtime:template-local@127.0.0.1:5434/app_test

# ---- Demo data -------------------------------------------------------------------------------
# The demo accounts' password for `pnpm db:seed --env local|staging`, at least 10 characters.
# Locally it falls back to DEMO_PASSWORD in apps/server/.dev.vars; CI uses STAGING_DEMO_PASSWORD.
# DEMO_PASSWORD=
# STAGING_DEMO_PASSWORD=

# ---- Cloudflare ------------------------------------------------------------------------------
# Deploys (CI) and `pnpm logs` (Workers Observability read). Wrangler deploys to the account in
# CLOUDFLARE_ACCOUNT_ID; staging and production can be different accounts.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ---- End-to-end tests ------------------------------------------------------------------------
# Unset: `pnpm e2e` runs against `pnpm dev` (https://app.local.private).
# E2E_BASE_URL=https://build-template-staging.your-subdomain.workers.dev
# The staging Worker's TEST_MAIL_SECRET, so e2e can read mail sent to .example addresses.
# E2E_TEST_MAIL_SECRET=
# `pnpm smoke`: fail unless /api/health reports this commit.
# EXPECTED_COMMIT=
# E2E_BUDGETS=1 checks the speed budgets (CI, against staging).
# E2E_BUDGETS=

# ---- Worker (apps/server/.dev.vars locally; `wrangler secret put` when deployed) -------------
# Listed so this file names everything. Setting them here does nothing.
#
# SESSION_PEPPER=             openssl rand -base64 32, different per environment
# DATABASE_URL=               Neon app_runtime, pooled URL (deployed only; unset locally)
# RESEND_API_KEY=             Resend; deployed email needs it and a verified domain
# MAIL_FROM=                  e.g. "Build Template <hello@yourdomain.com>"
# GOOGLE_CLIENT_ID=           Continue with Google: off until both are set
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=          Claude for Ask AI; deployed without it, Workers AI's Llama
# AI_MODELS=                  comma-separated KNOWN_MODELS ids, default first
# CONNECTION_ENCRYPTION_KEY=  openssl rand -base64 32: seals Zapier hook URLs and webhook secrets
# TEST_MAIL_SECRET=           staging only: lets e2e read mail sent to .example addresses
